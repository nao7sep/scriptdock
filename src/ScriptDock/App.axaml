<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScriptDock.App"
             Name="ScriptDock"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <!-- The theme palette, one complete set per theme (app-chrome conventions, Theme): the one
                 source of truth for ScriptDock's colours. Every surface reads it through DynamicResource,
                 and the code-built dialogs bind it the same way, so a theme change repaints open windows.
                 Dark is the electric console; light is the same console by day, on cool teal-gray paper. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF4F6"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFCFD"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#CFDDE2"/>
                    <!-- A text field is identified by its outline alone, so it holds 3:1 against its fill and surroundings. -->
                    <SolidColorBrush x:Key="FieldBorderBrush" Color="#748A92"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F2329"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4C636B"/>
                    <!-- Electric console: the cyan action. Dark uses bright cyan under dark ink; light a deeper cyan under white, which also marks focus on a pale surface. -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#0E7490"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#155E75"/>
                        <SolidColorBrush x:Key="AccentPressedBrush" Color="#164E63"/>
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#C9DEE4"/>
                    <SolidColorBrush x:Key="AccentForegroundDisabledBrush" Color="#4C636B"/>
                    <SolidColorBrush x:Key="InactiveActionBrush" Color="#B7C9CF"/>
                    <SolidColorBrush x:Key="InactiveActionForegroundBrush" Color="#0F2329"/>
                    <!-- Danger stays a separate semantic red. -->
                    <SolidColorBrush x:Key="DangerBrush" Color="#BE3455"/>
                    <SolidColorBrush x:Key="DangerHoverBrush" Color="#A62B48"/>
                        <SolidColorBrush x:Key="DangerPressedBrush" Color="#8E223B"/>
                    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FBEBEE"/>
                    <!-- State colours. DangerText is danger red as text (validation errors, removed scripts); ScriptNew is the orange dot flagging a newly-found script; ScriptHidden dims hidden scripts; Running is the green run indicator. -->
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#B4233F"/>
                    <SolidColorBrush x:Key="ScriptNewBrush" Color="#C2410C"/>
                    <SolidColorBrush x:Key="ScriptHiddenBrush" Color="#52676F"/>
                    <SolidColorBrush x:Key="RunningBrush" Color="#15803D"/>
                    <SolidColorBrush x:Key="ContentWellBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SelectionBrush" Color="#D5EEF4"/>
                    <SolidColorBrush x:Key="SelectionHoverBrush" Color="#C7E6EE"/>
                    <SolidColorBrush x:Key="SelectionSecondaryBrush" Color="#3F555C"/>
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#F1F6F8"/>
                    <SolidColorBrush x:Key="ChipHoverBrush" Color="#E3EDF1"/>
                        <SolidColorBrush x:Key="ChipPressedBrush" Color="#D8E6EB"/>
                    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#D5EEF4"/>
                    <SolidColorBrush x:Key="DisabledInputBrush" Color="#F1F5F7"/>
                    <SolidColorBrush x:Key="DisabledInputBorderBrush" Color="#DCE5E9"/>
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#7B9199"/>
                    <!-- The neutral button, one surface ladder that deepens from rest through hover to press,
                         with an edge that holds in both themes. Off, it keeps its fill and outline one step
                         quieter under the disabled ink: the app's named disabled pair, as the commit's is. -->
                    <SolidColorBrush x:Key="ButtonBrush" Color="#E3ECEF"/>
                    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#D6E3E8"/>
                        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#C8D9DF"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#BCCDD4"/>
                    <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#EAF1F3"/>
                    <SolidColorBrush x:Key="ButtonDisabledBorderBrush" Color="#D3DFE3"/>
                    <!-- A field's outline under the pointer, one step firmer than its resting FieldBorder. -->
                    <SolidColorBrush x:Key="FieldHoverBorderBrush" Color="#566D75"/>
                    <!-- The one keyboard-focus ring, in the accent; quieter while the window is inactive. -->
                    <SolidColorBrush x:Key="FocusRingBrush" Color="#0E7490"/>
                    <SolidColorBrush x:Key="FocusRingInactiveBrush" Color="#9DB8C0"/>
                    <!-- The ring as the control draws it: 2px of FocusRing standing 1px clear of the edge,
                         the gap in the window colour; a row draws its ring just inside its own edge. -->
                    <BoxShadows x:Key="FocusRingShadow">0 0 0 1 #EEF4F6, 0 0 0 3 #0E7490</BoxShadows>
                    <BoxShadows x:Key="FocusRingInactiveShadow">0 0 0 1 #EEF4F6, 0 0 0 3 #9DB8C0</BoxShadows>
                    <BoxShadows x:Key="RowFocusRingShadow">inset 0 0 0 2 #0E7490</BoxShadows>
                    <BoxShadows x:Key="RowFocusRingInactiveShadow">inset 0 0 0 2 #9DB8C0</BoxShadows>
                    <!-- The scroll-bar thumb in the app's palette: every region here floats its bar,
                         which is the brush that one reads (app-chrome conventions). -->
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#748A92"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F181D"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#16252B"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#2B414A"/>
                    <!-- A text field is identified by its outline alone, so it holds 3:1 against its fill and surroundings. -->
                    <SolidColorBrush x:Key="FieldBorderBrush" Color="#65808A"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8F2F4"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#93A9B0"/>
                    <!-- Electric console: the cyan action. Dark uses bright cyan under dark ink; light a deeper cyan under white, which also marks focus on a pale surface. -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#22D3EE"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#67E8F9"/>
                        <SolidColorBrush x:Key="AccentPressedBrush" Color="#A5F3FC"/>
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#062126"/>
                    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#174650"/>
                    <SolidColorBrush x:Key="AccentForegroundDisabledBrush" Color="#B4C4C8"/>
                    <SolidColorBrush x:Key="InactiveActionBrush" Color="#3B5962"/>
                    <SolidColorBrush x:Key="InactiveActionForegroundBrush" Color="#D4E0E3"/>
                    <!-- Danger stays a separate semantic red. -->
                    <SolidColorBrush x:Key="DangerBrush" Color="#BE3455"/>
                    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C83A58"/>
                        <!-- Deepens although the hover lifts: white on the hover fill is
                             already 5.00:1, so one more lift drops the label under the floor. -->
                        <SolidColorBrush x:Key="DangerPressedBrush" Color="#A82C4A"/>
                    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#2B171B"/>
                    <!-- State colours. DangerText is danger red as text (validation errors, removed scripts); ScriptNew is the orange dot flagging a newly-found script; ScriptHidden dims hidden scripts; Running is the green run indicator. -->
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#FB7185"/>
                    <SolidColorBrush x:Key="ScriptNewBrush" Color="#FB923C"/>
                    <SolidColorBrush x:Key="ScriptHiddenBrush" Color="#889FA7"/>
                    <SolidColorBrush x:Key="RunningBrush" Color="#4ADE80"/>
                    <SolidColorBrush x:Key="ContentWellBrush" Color="#081216"/>
                    <SolidColorBrush x:Key="SelectionBrush" Color="#153843"/>
                    <SolidColorBrush x:Key="SelectionHoverBrush" Color="#1B4653"/>
                    <SolidColorBrush x:Key="SelectionSecondaryBrush" Color="#B4C4C8"/>
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#14242B"/>
                    <SolidColorBrush x:Key="ChipHoverBrush" Color="#1B3139"/>
                        <!-- Deepens although the hover lifts: the dark neutral ramp has already
                             spent its headroom, and a further lift takes the quieter inks under 4.5. -->
                        <SolidColorBrush x:Key="ChipPressedBrush" Color="#0E1B21"/>
                    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#193640"/>
                    <SolidColorBrush x:Key="DisabledInputBrush" Color="#081115"/>
                    <SolidColorBrush x:Key="DisabledInputBorderBrush" Color="#182A31"/>
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5F747B"/>
                    <!-- The neutral button: this theme's ladder lifts from rest through hover to press. -->
                    <SolidColorBrush x:Key="ButtonBrush" Color="#1C2E35"/>
                    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#233941"/>
                        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#2A444D"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#34505A"/>
                    <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#16252B"/>
                    <SolidColorBrush x:Key="ButtonDisabledBorderBrush" Color="#243840"/>
                    <SolidColorBrush x:Key="FieldHoverBorderBrush" Color="#83A0AA"/>
                    <SolidColorBrush x:Key="FocusRingBrush" Color="#22D3EE"/>
                    <SolidColorBrush x:Key="FocusRingInactiveBrush" Color="#3F6570"/>
                    <BoxShadows x:Key="FocusRingShadow">0 0 0 1 #0F181D, 0 0 0 3 #22D3EE</BoxShadows>
                    <BoxShadows x:Key="FocusRingInactiveShadow">0 0 0 1 #0F181D, 0 0 0 3 #3F6570</BoxShadows>
                    <BoxShadows x:Key="RowFocusRingShadow">inset 0 0 0 2 #22D3EE</BoxShadows>
                    <BoxShadows x:Key="RowFocusRingInactiveShadow">inset 0 0 0 2 #3F6570</BoxShadows>
                    <!-- The scroll-bar thumb in the app's palette: every region here floats its bar,
                         which is the brush that one reads (app-chrome conventions). -->
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#5B7680"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The scroll-bar track stays transparent in both themes; thickness, hit target, geometry, and
                 keyboard behavior stay with the native Fluent control. -->
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent"/>

            <!-- ScriptDock's control vocabulary (interface-styling conventions): two control heights,
                 and corners that grow with the surface — rows, then compact controls, then standard
                 controls and the wells inside a card, then the card. Every control reads these, so one
                 change moves the whole app. -->
            <x:Double x:Key="ControlHeight">32</x:Double>
            <x:Double x:Key="CompactControlHeight">28</x:Double>
            <CornerRadius x:Key="RowRadius">5</CornerRadius>
            <CornerRadius x:Key="CompactRadius">6</CornerRadius>
            <CornerRadius x:Key="ControlRadius">7</CornerRadius>
            <CornerRadius x:Key="WellRadius">7</CornerRadius>
            <CornerRadius x:Key="CardRadius">10</CornerRadius>

            <!-- The app-wide UI (chrome) font. The default is the bundled Inter; the view model overrides
                 this resource at runtime from the configured UI font, and the Window style below binds it
                 via DynamicResource so the change applies live across every window. -->
            <!-- The collection URI, not the bare name: bare "Inter" falls back to the platform font. -->
            <FontFamily x:Key="AppFontFamily">fonts:Inter#Inter</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Fluent's own accent, window region, and error text, per theme; they repeat the
                     palette's Accent, AppBackground, and DangerText values (a palette entry takes a
                     color, not a brush). -->
                <ColorPaletteResources x:Key="Light"
                                       Accent="#0E7490"
                                       RegionColor="#EEF4F6"
                                       ErrorText="#B4233F"/>
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#22D3EE"
                                       RegionColor="#0F181D"
                                       ErrorText="#FB7185"/>
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Every window (main + dialogs) takes the configured UI font; FontFamily inherits to child
             controls. The read-only output console sets its own monospace font, so it is unaffected. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>



        <!-- The one keyboard-focus ring (interface-styling conventions): 2px of accent standing 1px
             clear of the control and following its corners, shown only when focus came from the
             keyboard, and quieter while its window is inactive. A button draws it as its own shadow
             rather than as an adorner: an adorner is clipped to its control's bounds, so a ring outside
             them never shows, and one freed from that clip would float over whatever a scroll region
             moved the control under. A list row draws it just inside its edge, where the row's own
             inset keeps it clear of the chip or text it holds. -->
        <Style Selector="Button, ListBoxItem">
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="Button /template/ ContentPresenter, ListBoxItem /template/ ContentPresenter">
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="Button:focus-visible /template/ ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource FocusRingShadow}"/>
        </Style>
        <Style Selector="Window.windowInactive Button:focus-visible /template/ ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource FocusRingInactiveShadow}"/>
        </Style>
        <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource RowFocusRingShadow}"/>
        </Style>
        <Style Selector="Window.windowInactive ListBoxItem:focus-visible /template/ ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource RowFocusRingInactiveShadow}"/>
        </Style>
        <!-- A checkbox or radio has no presenter to draw on; its ring is an adorner on its own bounds,
             which already stand clear of the box. -->
        <Style Selector="CheckBox, RadioButton">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border Classes="focusRing" Classes.inactive="{Binding !$parent[Window].IsActive}"
                            CornerRadius="{StaticResource RowRadius}"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>
        <!-- A splitter takes the arrow keys, so it shows where focus is the same way. -->
        <Style Selector="GridSplitter">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border Classes="focusRing" Classes.inactive="{Binding !$parent[Window].IsActive}"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>
        <Style Selector="Border.focusRing">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        </Style>
        <Style Selector="Border.focusRing.inactive">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingInactiveBrush}"/>
        </Style>

        <!-- The standard button: the secondary role, and the anatomy every other role builds on. A
             button states everything it requires of its label: that the content is centred, and that
             the padding around it is symmetric — Avalonia's stock padding is lopsided (8,5,8,6). Its
             height comes from the control sizes, not from its text, and every state is a step of its
             own surface rather than the toolkit's grey. -->
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Off, the neutral button keeps its anatomy one step quieter under the disabled ink: the
             app's named pair, as the commit's below, never the toolkit's fade. -->
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonDisabledBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDisabledBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
        </Style>

        <!-- The compact button: pane toolbars and in-body links, a step smaller in height, text and
             corner. The icon variant is square-ish around its drawn mark. -->
        <Style Selector="Button.tool">
            <Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="{StaticResource CompactRadius}"/>
        </Style>
        <Style Selector="Button.tool.icon">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dialog accent (commit) button -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.accent:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>

        <!-- Avalonia drops the :focus match when a native window deactivates even though the
             control retains keyboard focus. Without an explicit inactive state, the primary
             action snaps back to its brighter base accent. DialogBase owns this class so the
             same muted treatment covers every app-authored dialog and startup notice. -->
        <Style Selector="Window.windowInactive Button.accent /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource InactiveActionBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InactiveActionForegroundBrush}"/>
        </Style>
        <Style Selector="Window.windowInactive Button.accent:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource InactiveActionBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InactiveActionForegroundBrush}"/>
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <!-- Disabled commit remains readable while clearly receding from the live cyan action. -->
        <Style Selector="Button.accent:disabled">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource AccentDisabledBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundDisabledBrush}"/>
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource AccentDisabledBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundDisabledBrush}"/>
        </Style>

        <!-- Dialog destructive button -->
        <Style Selector="Button.destructive">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.destructive /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.destructive:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.destructive:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.destructive:pressed /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource DangerPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- State colours. The models and view models expose state (a script's flags, a run's
             lifecycle) and these styles map it to theme brushes, so an open window repaints when the
             theme changes. Later rules win, so a removed script reads red even when also hidden. -->
        <Style Selector="TextBlock.scriptName">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.scriptName.hidden">
            <Setter Property="Foreground" Value="{DynamicResource ScriptHiddenBrush}"/>
        </Style>
        <Style Selector="TextBlock.scriptName.removed">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </Style>
        <Style Selector="Border.statePill">
            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.statePill.running">
            <Setter Property="Background" Value="{DynamicResource RunningBrush}"/>
        </Style>
        <Style Selector="Border.statePill.failed">
            <Setter Property="Background" Value="{DynamicResource DangerTextBrush}"/>
        </Style>

        <!-- Launcher surfaces: card panels, card headers, and compact toolbar buttons. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <!-- A recessed content well inside a card (the console): the well radius, a step under the card's. -->
        <Style Selector="Border.well">
            <Setter Property="Background" Value="{DynamicResource ContentWellBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource WellRadius}"/>
        </Style>
        <!-- A card's header strip: the title/toolbar row set off from the content by a single bottom
             border line. Used by a card with Padding=0 so the line spans the full width. The fixed
             height keeps every section header the same height regardless of whether it holds toolbar
             buttons (Scripts/Recent) or just a title (Output); horizontal-only padding leaves the
             centered content to sit consistently within that height. -->
        <Style Selector="Border.sectionHeader">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <!-- A floor, not a fixed height: every pane header is 46 tall, and a language whose labels
                 need more room grows the header rather than having its buttons clipped. -->
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style Selector="TextBlock.cardHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- A persistent result's close mark has a stable compact hit target and no button chrome
             until hover/focus. It does not inherit the text-oriented tool-button geometry. -->
        <Style Selector="Button.resultClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.resultClose /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.resultClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
        </Style>
        <Style Selector="Button.resultClose:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
        </Style>
        <Style Selector="Button.resultClose:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBox.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Lists are recessed content wells with rounded corners; their rows are items inset from the
             well's edge and rounded, with hover, pressed and selected fills — a quiet cyan tint for the
             selection, not a solid accent. -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource ContentWellBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource WellRadius}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <!-- A list that belongs to a form (Settings) is outlined like the field that feeds it. -->
        <Style Selector="ListBox.boxed">
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource RowRadius}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipPressedBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionHoverBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionHoverBrush}"/>
        </Style>

        <!-- One-line fields: every kind takes one height, edge, corner and fill (interface-styling
             conventions), so a select beside a text box, or a button beside either, lines up. A text
             field's resting outline is its only boundary, so it takes the 3:1 field border; it firms
             under the pointer and turns accent with focus, on the same recessed fill throughout. -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="Background" Value="{DynamicResource ContentWellBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
            <!-- A single-line field states that its text centres and that its padding is
                 symmetric. That is the whole of the intent; if Avalonia's text layout
                 still lands the line slightly off, that is the toolkit's, not something
                 to chase with lopsided values. -->
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ContentWellBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldHoverBorderBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ContentWellBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="Background" Value="{DynamicResource ContentWellBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ContentWellBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldHoverBorderBrush}"/>
        </Style>
        <Style Selector="ComboBox:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldHoverBorderBrush}"/>
        </Style>
        <Style Selector="TextBox.stdin:disabled">
            <Setter Property="Background" Value="{DynamicResource DisabledInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource DisabledTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledInputBorderBrush}"/>
        </Style>
        <Style Selector="TextBox.stdin:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DisabledInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledInputBorderBrush}"/>
        </Style>

    </Application.Styles>
</Application>
