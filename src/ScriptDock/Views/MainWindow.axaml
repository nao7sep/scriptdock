<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScriptDock.ViewModels"
        xmlns:models="using:ScriptDock.Models"
        xmlns:ctl="using:ScriptDock.Controls"
        xmlns:i18n="using:ScriptDock.I18n"
        x:Class="ScriptDock.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ScriptDock"
        Icon="/Assets/icon.png"
        Width="1100" Height="720"
        KeyDown="OnWindowKeyDown"
        Background="{DynamicResource AppBackgroundBrush}"><!-- The window inherits the
        application's theme variant (AppTheme), which Avalonia also uses to paint the native title
        bar. The MinWidth/MinHeight are intentionally NOT set here: they are derived from the
        layout in WindowMetrics and assigned in OnLoaded. -->

    <Window.Resources>
        <!-- Content-sized script chip: slightly raised from the list well. A newly-found script is
             flagged by an orange dot;
             removed → red text, hidden → gray text; green dot when running. The 1px border is transparent
             by default (the selected-chip style colours it, so selection never shifts the layout). -->
        <DataTemplate x:Key="ScriptTile" x:DataType="models:ScriptItem">
            <Border Classes="chip"
                    Background="{DynamicResource ChipBackgroundBrush}"
                    BorderThickness="1"
                    CornerRadius="6" Padding="12,7" Margin="3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource ScriptNewBrush}" VerticalAlignment="Center" IsVisible="{Binding IsNew}"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource RunningBrush}" VerticalAlignment="Center" IsVisible="{Binding IsRunning}"/>
                    <!-- The name's colour follows the script's state through the scriptName styles, so it
                         repaints with the theme: removed wins over hidden. -->
                    <TextBlock Text="{Binding DisplayName}" Classes="scriptName"
                               Classes.hidden="{Binding IsHidden}" Classes.removed="{Binding IsRemoved}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- A 3px list inset plus each chip's 3px margin makes the outer inset and the
             6px gaps between neighbouring chips visually equal. -->
        <Style Selector="ListBox#ScriptsList">
            <Setter Property="Padding" Value="3"/>
        </Style>
        <!-- Scripts list renders content-sized chips in a WrapPanel: strip the Fluent item
             chrome (large default padding and min height) so the tiles pack tightly and each
             tile's own padding and margin control the look. -->
        <Style Selector="ListBox#ScriptsList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <!-- The chip owns hover/selection emphasis through its reserved 1px border. Do not let the
             ListBoxItem background show through the chip's 3px margin as a thicker outer ring. -->
        <Style Selector="ListBox#ScriptsList ListBoxItem:pointerover /template/ ContentPresenter,
                         ListBox#ScriptsList ListBoxItem:selected /template/ ContentPresenter,
                         ListBox#ScriptsList ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox#ScriptsList ListBoxItem:pointerover Border.chip">
            <Setter Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <!-- Selected chip gets an accent ring (the chip reserves a transparent 1px border for this). -->
        <Style Selector="ListBox#ScriptsList ListBoxItem:selected Border.chip">
            <Setter Property="Background" Value="{DynamicResource ChipSelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ListBox#RecentList ListBoxItem:selected TextBlock.recentMeta">
            <Setter Property="Foreground" Value="{DynamicResource SelectionSecondaryBrush}"/>
        </Style>
    </Window.Styles>

    <!-- Header, persistent operational error, body, and status bar each get their own track. The
         error track collapses while healthy; when present it is measured into the native minimum,
         so persistent failure feedback never steals the content floor. -->
    <ScrollViewer x:Name="WindowViewport"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="LayoutRoot" RowDefinitions="Auto,Auto,*,Auto"
          Width="{Binding #WindowViewport.Viewport.Width}" Height="{Binding #WindowViewport.Viewport.Height}">

        <!-- Flat header: wordmark + hamburger, with a single bottom border. -->
        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <!-- Hamburger docked right; the wordmark is the last (fill) child so it stays left. -->
                <!-- Padding 8,6 (not the tool button's text-oriented 12,6): the icon needs as much room
                     over and under the bars as beside them, or the bars read as filling the button. -->
                <Button Classes="tool" DockPanel.Dock="Right" Padding="8,6"
                        i18n:Localized.AutomationName="menu.application"
                        i18n:Localized.ToolTip="menu.application">
                    <!-- Hamburger as three strokes: bars 16 long and 2 thick with 5 between them, the
                         fleet's Avalonia hamburger. Filled square bars sat closer and read heavier. -->
                    <Path Width="18" Height="16" Stretch="None"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="2" StrokeLineCap="Round" UseLayoutRounding="True"
                          Data="M1,1 H17 M1,8 H17 M1,15 H17"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem i18n:Localized.Header="menu.revealLogs" Click="OnRevealLogsClick"/>
                            <MenuItem i18n:Localized.Header="menu.settings" Click="OnSettingsClick"/>
                            <MenuItem i18n:Localized.Header="menu.shortcuts" Click="OnShortcutsClick"/>
                            <MenuItem i18n:Localized.Header="menu.about" Click="OnAboutClick"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Text="ScriptDock" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Operational failures are independent from the replaceable activity line. One keyed
             failure is shown at a time; the count preserves additional unresolved failures and
             the close mark reveals the next. The concrete message is the non-colour cue. -->
        <Border x:Name="OperationalErrorBar" Grid.Row="1"
                IsVisible="{Binding HasOperationalError}"
                Background="{DynamicResource ErrorSurfaceBrush}" BorderBrush="{DynamicResource DangerTextBrush}"
                BorderThickness="0,0,0,1" Padding="14,10"
                AutomationProperties.LiveSetting="Assertive">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding OperationalError}" VerticalAlignment="Top"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="{Binding OperationalErrorCountText}"
                           IsVisible="{Binding HasMultipleOperationalErrors}"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Classes="resultClose" VerticalAlignment="Top"
                        Command="{Binding DismissOperationalErrorCommand}"
                        i18n:Localized.AutomationName="error.dismiss" i18n:Localized.ToolTip="error.dismiss">
                    <Path Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource DangerTextBrush}" StrokeThickness="1.8"
                          StrokeLineCap="Round"
                          Data="M1,1 L9,9 M9,1 L1,9"/>
                </Button>
            </Grid>
        </Border>

        <!-- Status bar in its own bottom track so it stays reserved at every window size. It contains
             standing facts only: total scripts, hidden scripts, and running scripts. One-off scan and
             configuration outcomes belong to the Scripts pane below. -->
        <Border x:Name="StatusBar" Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding ScriptCountText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="·" Foreground="{DynamicResource BorderBrush}" IsVisible="{Binding HasHidden}"/>
                <TextBlock Text="{Binding HiddenCountText}" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasHidden}"/>
                <TextBlock Text="·" Foreground="{DynamicResource BorderBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource RunningBrush}" VerticalAlignment="Center" IsVisible="{Binding HasRunning}"/>
                    <TextBlock Text="{Binding RunningCountText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body: a left column (Scripts above Output, parted by a row splitter) beside a full-height
             Recent column (parted by a column splitter). The left column fills (*) and each pane shrinks
             to its MinWidth/MinHeight under window pressure; the Recent column and the console row are
             fixed pixel sizes the user drags (and which persist), each floored by its MinWidth/MinHeight.
             The window's own minimum (derived in WindowMetrics) reserves every pane min; because a
             fixed-pixel track does not shrink on its own, OnLoaded re-derives the Recent width and console
             height on every resize (ClampPanesToWindow) so neither can spill past the shrinking window. -->
        <Grid x:Name="BodyGrid" Grid.Row="2" Margin="12">
            <!-- Both body columns carry a real minimum width; WindowMetrics sums these (read from the
                 live columns) to derive the window MinWidth and to back the pane-size clamp. These XAML
                 values are a floor: OnLoaded measures the Scripts and Recent header button rows and
                 raises each column minimum to fit them, so the right-aligned buttons can never overlap
                 a section title (a font-dependent width the header itself dictates). The Recent column
                 is the fixed-width right pane; the column splitter sits between the two in its own 6px
                 column and spans the full body height. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="340" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: Scripts above Output. The Scripts row fills (*) and shrinks to its MinHeight
                 under window pressure; the console row is a fixed pixel height the user sizes with the row
                 splitter (and which persists), floored by its MinHeight. -->
            <Grid x:Name="LeftPanesGrid" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="6"/>
                    <!-- 160 = section header (~40) + stdin input (~46) + the well's margin and a few
                         readable lines; below this the console well collapses to nothing. -->
                    <RowDefinition Height="220" MinHeight="160"/>
                </Grid.RowDefinitions>

                <!-- Scripts (content-sized tiles); Rescan + Show-hidden act on this list. -->
                <Border Grid.Row="0" Classes="card" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="sectionHeader" x:Name="ScriptsHeader">
                            <DockPanel>
                                <TextBlock i18n:Localized.Text="scripts.title" Classes="cardHeader" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Selection actions (act on the selected chip). -->
                                    <Button i18n:Localized.Content="scripts.run" Classes="tool" Command="{Binding RunScriptCommand}" CommandParameter="{Binding #ScriptsList.SelectedItem}"/>
                                    <!-- Label tracks the selected script: "Hide" for a visible one, "Show" for a hidden one. -->
                                    <Button Content="{Binding ToggleHiddenLabel}" Classes="tool" Command="{Binding ToggleHiddenCommand}" CommandParameter="{Binding #ScriptsList.SelectedItem}"/>
                                    <!-- List-level controls (act on the whole Scripts list). "Show hidden" is the one
                                         checkbox+label pair, so it carries extra horizontal margin to set that pair apart
                                         from the Hide button on its left and the Rescan button on its right — its tight
                                         internal box-to-label gap then reads as the connected unit. -->
                                    <CheckBox i18n:Localized.Content="scripts.showHidden" IsChecked="{Binding ShowHidden}" Margin="10,0" VerticalAlignment="Center"/>
                                    <Button i18n:Localized.Content="scripts.rescan" Classes="tool" Command="{Binding RescanCommand}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Scan progress/results and the saved-configuration consequence stay with the
                             catalog they affect instead of becoming permanent status-bar content. -->
                        <Border DockPanel.Dock="Top" IsVisible="{Binding HasCatalogResult}"
                                Background="{DynamicResource ChipBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="10,7" AutomationProperties.LiveSetting="Polite">
                            <TextBlock Text="{Binding CatalogResult}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Border>
                        <Grid Margin="10">
                            <ListBox x:Name="ScriptsList" ItemsSource="{Binding Scripts}"
                                     SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                                     ItemTemplate="{DynamicResource ScriptTile}"
                                     DoubleTapped="OnScriptDoubleTapped" KeyDown="OnScriptKeyDown">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <TextBlock i18n:Localized.Text="scripts.empty"
                                       IsVisible="{Binding NoScripts}" IsHitTestVisible="False"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="ConsoleSplitter" Grid.Row="1" Height="6" Background="Transparent" ResizeDirection="Rows" HorizontalAlignment="Stretch"/>

                <!-- Console: the selected Recent item's output (auto-scrolls when pinned to the bottom). -->
                <Border Grid.Row="2" Classes="card" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="sectionHeader">
                            <DockPanel>
                                <!-- The selected script's name as a colored pill, floated right, so the
                                     console makes clear whose output it is shown only when a run is selected. -->
                                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                        Background="{DynamicResource SelectionBrush}" CornerRadius="10" Padding="10,3"
                                        IsVisible="{Binding HasSelection}">
                                    <TextBlock Text="{Binding SelectedRecentEntry.DisplayName}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <TextBlock i18n:Localized.Text="output.title" Classes="cardHeader" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <!-- Per-process action failures are owned by the selected run's detail/console.
                             They persist across selection changes and are never duplicated in global chrome. -->
                        <Border x:Name="RecentActionErrorBar" DockPanel.Dock="Top" IsVisible="{Binding HasRecentActionError}"
                                Background="{DynamicResource ErrorSurfaceBrush}" BorderBrush="{DynamicResource DangerTextBrush}"
                                BorderThickness="0,0,0,1" Padding="10,10"
                                AutomationProperties.LiveSetting="{Binding RecentActionLiveSetting}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                                <TextBlock Text="{Binding RecentActionError}" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                           />
                                <TextBlock Grid.Column="1" Text="{Binding RecentActionErrorCountText}"
                                           IsVisible="{Binding HasMultipleRecentActionErrors}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Classes="resultClose" VerticalAlignment="Top"
                                        Command="{Binding DismissRecentActionErrorCommand}"
                                        i18n:Localized.AutomationName="output.dismissError" i18n:Localized.ToolTip="output.dismissError">
                                    <Path Width="10" Height="10" Stretch="Uniform"
                                          Stroke="{DynamicResource DangerTextBrush}" StrokeThickness="1.8"
                                          StrokeLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9"/>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- Interactive input: a line typed here is sent to the selected running script's stdin
                             on Enter. Enabled only while that run is running and accepts input. -->
                        <ctl:ComposingTextBox x:Name="ConsoleInput" Classes="stdin" DockPanel.Dock="Bottom" Margin="10,0,10,10" SubmitOnEnter="True"
                                 IsEnabled="{Binding CanSendInput}"
                                 i18n:Localized.PlaceholderText="output.inputPlaceholder"
                                 Submitted="OnConsoleInputSubmitted"/>
                        <!-- Recessed terminal-like field so the log reads as its own surface, not part of the header. -->
                        <Border Margin="10" Background="{DynamicResource ContentWellBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                            <ScrollViewer x:Name="ConsoleScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <SelectableTextBlock Text="{Binding SelectedOutput}" TextWrapping="NoWrap"
                                                     FontFamily="Menlo,Consolas,monospace" FontSize="12"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="RecentSplitter" Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns"/>

            <!-- Recent (running + recently-run, dismissible); the full-height right column. -->
            <Border Grid.Column="2" Classes="card" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="sectionHeader" x:Name="RecentHeader">
                        <DockPanel>
                            <TextBlock i18n:Localized.Text="recent.title" Classes="cardHeader" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button i18n:Localized.Content="recent.run" Classes="tool" Command="{Binding RunOrRestartCommand}" CommandParameter="{Binding #RecentList.SelectedItem}"/>
                                <Button i18n:Localized.Content="recent.stop" Classes="tool" Command="{Binding StopEntryCommand}" CommandParameter="{Binding #RecentList.SelectedItem}"/>
                                <Button i18n:Localized.Content="recent.dismiss" Classes="tool" Command="{Binding DismissEntryCommand}" CommandParameter="{Binding #RecentList.SelectedItem}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Margin="10">
                        <ListBox x:Name="RecentList" ItemsSource="{Binding Recent}"
                                 SelectedItem="{Binding SelectedRecentEntry, Mode=TwoWay}"
                                 DoubleTapped="OnRecentDoubleTapped" KeyDown="OnRecentKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentEntry">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LastRanDisplay}" Classes="recentMeta" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <!-- State pill: colour distinguishes running / done / failed / idle at a glance. -->
                                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                Classes="statePill" Classes.running="{Binding IsRunning}"
                                                Classes.failed="{Binding IsPillFailed}" CornerRadius="10" Padding="9,2">
                                            <TextBlock Text="{Binding StatePillText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppBackgroundBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock i18n:Localized.Text="recent.empty"
                                   IsVisible="{Binding NoRecent}" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
