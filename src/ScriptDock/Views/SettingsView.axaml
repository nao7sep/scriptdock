<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScriptDock.ViewModels"
             xmlns:ctl="using:ScriptDock.Controls"
             xmlns:i18n="using:ScriptDock.I18n"
             xmlns:views="using:ScriptDock.Views"
             x:Class="ScriptDock.Views.SettingsView"
             x:DataType="vm:SettingsDialogViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="EditableRow" x:DataType="vm:EditableItem">
            <StackPanel Spacing="2" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <ctl:ComposingTextBox Text="{Binding Text}" Classes.invalid="{Binding HasError}"
                                          AutomationProperties.HelpText="{Binding Error}"/>
                    <Button Grid.Column="1" Classes="resultClose" VerticalAlignment="Center" Click="OnRemoveRowClick"
                            i18n:Localized.AutomationName="common.remove" i18n:Localized.ToolTip="common.remove">
                        <Path Width="10" Height="10" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                              StrokeLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9"/>
                    </Button>
                </Grid>
                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                           Foreground="{DynamicResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- A checkbox caption wraps rather than being cut off: the settings dialog has a fixed width,
             and several of these captions are whole sentences that grow by half again in German. -->
        <Style Selector="CheckBox TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <!-- Two tabs, chosen in the dialog's band above this body: General, and the ignore patterns, whose list
         fills its tab. Only the shown tab's panel takes room, so the dialog fits the tab it shows. -->
    <StackPanel Spacing="20">
    <StackPanel x:Name="GeneralPanel" Spacing="20" IsVisible="{Binding IsGeneralTab}">

        <!-- Appearance: the theme and the UI (chrome) font lead, set apart from the scanning/process
             settings. The theme is the platform radio group (one tab stop, arrow keys move and select),
             grouped by its shared parent rather than a GroupName, which Avalonia tracks across every
             dialog not yet in a window. It is part of the draft and applies on Save. -->
        <!-- The interface language, first because it governs every other label here. The names are
             written in their own languages so a reader finds theirs whatever is showing; only System
             is translated. It applies on Save with its neighbours (localization conventions). -->
        <!-- The language and the zone times are shown in sit side by side. The zone comes from the
             platform's IANA zones, System first with the zone it resolves to now (timestamp-conventions,
             Time zones). -->
        <WrapPanel ItemSpacing="24" LineSpacing="20">
            <StackPanel Spacing="8">
                <TextBlock i18n:Localized.Text="settings.language" Classes="cardHeader"/>
                <ComboBox x:Name="LanguageChoice" MinWidth="200"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding Language}"
                          DisplayMemberBinding="{Binding Name}"
                          i18n:Localized.AutomationName="settings.language"/>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock i18n:Localized.Text="settings.timeZone" Classes="cardHeader"/>
                <ComboBox x:Name="TimeZoneChoice" MinWidth="200"
                          ItemsSource="{Binding TimeZoneOptions}"
                          SelectedItem="{Binding TimeZone}"
                          DisplayMemberBinding="{Binding Name}"
                          i18n:Localized.AutomationName="settings.timeZone"/>
            </StackPanel>
        </WrapPanel>

        <StackPanel Spacing="8">
            <TextBlock i18n:Localized.Text="settings.theme" Classes="cardHeader"/>
            <StackPanel x:Name="ThemeChoices" Orientation="Horizontal" Spacing="20"
                        i18n:Localized.AutomationName="settings.theme">
                <RadioButton Content="{Binding ThemeSystemLabel}" IsChecked="{Binding IsThemeSystem}"/>
                <RadioButton i18n:Localized.Content="settings.themeLight" IsChecked="{Binding IsThemeLight}"/>
                <RadioButton i18n:Localized.Content="settings.themeDark" IsChecked="{Binding IsThemeDark}"/>
            </StackPanel>
            <TextBlock i18n:Localized.Text="settings.themeHint"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- The read-only output console keeps its own monospace font and is unaffected by the UI font. -->
        <StackPanel Spacing="8">
            <TextBlock i18n:Localized.Text="settings.uiFont" Classes="cardHeader"/>
            <ctl:ComposingTextBox x:Name="UiFontEntry" Text="{Binding UiFontFamily}" PlaceholderText="Inter"/>
            <TextBlock i18n:Localized.Text="settings.uiFontHint"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Root directories: chosen with the native folder picker, not typed — they are
             directories that exist on disk, so picking beats hand-entering a path. -->
        <StackPanel Spacing="8">
            <TextBlock i18n:Localized.Text="settings.roots" Classes="cardHeader"/>
            <!-- A folder keeps its first and final segments on one line. -->
            <ListBox x:Name="RootList" ItemsSource="{Binding RootDirs}" Height="96" KeyDown="OnRootListKeyDown"
                     Classes="boxed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Classes="itemPath"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Standard buttons, the height of the fields their neighbours sit beside. -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button i18n:Localized.Content="settings.addRoot" Click="OnAddRootClick"/>
                <!-- Remove acts on the selected folder, so it waits for one; Delete and Backspace on the list do the same. -->
                <Button x:Name="RemoveRoot" i18n:Localized.Content="common.remove" Click="OnRemoveRootClick"
                        IsEnabled="{Binding #RootList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
            <Grid x:Name="RootPickerResult" ColumnDefinitions="*,Auto" ColumnSpacing="7"
                  IsVisible="{Binding HasRootPickerResult}"
                  AutomationProperties.Name="{Binding RootPickerResult}"
                  AutomationProperties.LiveSetting="Assertive">
                <TextBlock x:Name="RootPickerResultText" Text="{Binding RootPickerResult}" VerticalAlignment="Top"
                           Foreground="{DynamicResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                <Button x:Name="CloseRootPickerResult" Grid.Column="1"
                        Classes="resultClose" VerticalAlignment="Top"
                        views:FirstLineAlignment.To="{Binding #RootPickerResultText}"
                        Click="OnCloseRootPickerResult"
                        i18n:Localized.AutomationName="settings.closeRootResult"
                        i18n:Localized.ToolTip="common.close">
                    <Path Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource DangerTextBrush}" StrokeThickness="1.8"
                          StrokeLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Extensions. A list's reset sits in its header row (config-sets-conventions); a long header
             wraps beside it rather than being cut off. -->
        <StackPanel Spacing="8">
            <DockPanel>
                <Button x:Name="ResetExtensions" DockPanel.Dock="Right" Classes="tool" VerticalAlignment="Center"
                        i18n:Localized.Content="settings.resetExtensions" Click="OnResetExtensionsClick"/>
                <TextBlock i18n:Localized.Text="settings.extensions" Classes="cardHeader" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <!-- One editable row per item (config-sets-conventions, In the interface): any item changes in
                 place, Save trims each row and drops blank ones, and a row that fails its check is marked
                 with a message naming it. Each row removes itself. -->
            <ScrollViewer MaxHeight="168" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ExtList" ItemsSource="{Binding Extensions}" ItemTemplate="{StaticResource EditableRow}"/>
            </ScrollViewer>
            <DockPanel>
                <Button i18n:Localized.Content="common.add" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnAddExtClick"/>
                <ctl:ComposingTextBox x:Name="ExtEntry" PlaceholderText=".command" SubmitOnEnter="True" Submitted="OnExtSubmitted"
                                      Classes.invalid="{Binding HasExtensionError}"
                                      i18n:Localized.AutomationName="settings.extension"
                                      AutomationProperties.HelpText="{Binding ExtensionError}"
                                      AutomationProperties.ItemStatus="{Binding ExtensionItemStatus}"/>
            </DockPanel>
            <Grid x:Name="ExtensionErrorResult" IsVisible="{Binding HasExtensionError}"
                  AutomationProperties.LiveSetting="Assertive">
                <TextBlock Text="{Binding ExtensionError}"
                           Foreground="{DynamicResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Grid>
        </StackPanel>

        <!-- Whether a script that exits with a code other than 0 reads as an error, in Recent and in
             Records; off by default. Records keeps the code either way. -->
        <StackPanel Spacing="8">
            <TextBlock i18n:Localized.Text="settings.exitCodes" Classes="cardHeader"/>
            <CheckBox x:Name="NonZeroExitIsError" IsChecked="{Binding NonZeroExitIsError}"
                      i18n:Localized.Content="settings.nonZeroExitIsError"/>
            <TextBlock i18n:Localized.Text="settings.nonZeroExitIsErrorHint"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

    </StackPanel>

    <!-- The ignore patterns, checked in order; the first that matches a folder or script names why the scan
         left it out. One editable row per pattern (config-sets-conventions, In the interface): its text, how
         that text reads, and its own remove button, with a built-in's note under it in the interface
         language. Add appends a blank row to type into; Save trims each row, drops blank ones, and marks a
         row that fails its check with a message naming it. -->
    <StackPanel x:Name="IgnorePatternsPanel" Spacing="12" IsVisible="{Binding IsIgnorePatternsTab}">
        <TextBlock i18n:Localized.Text="settings.ignorePatternsHint"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock x:Name="PatternsEmpty" i18n:Localized.Text="settings.ignorePatternsEmpty"
                   IsVisible="{Binding !IgnorePatterns.Count}"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        <!-- The type column takes the width of its widest choice in every row, so the fields line up. -->
        <ItemsControl x:Name="PatternList" ItemsSource="{Binding IgnorePatterns}" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IgnorePatternRow">
                    <StackPanel Spacing="2" Margin="0,0,0,10">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PatternKind"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ctl:ComposingTextBox Text="{Binding Text}" Classes.invalid="{Binding HasError}"
                                                  i18n:Localized.AutomationName="settings.ignorePattern"
                                                  AutomationProperties.HelpText="{Binding Error}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding KindIndex}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      i18n:Localized.AutomationName="settings.patternKind">
                                <ComboBoxItem i18n:Localized.Content="settings.patternWildcard"/>
                                <ComboBoxItem i18n:Localized.Content="settings.patternRegex"/>
                            </ComboBox>
                            <Button Grid.Column="2" Classes="resultClose" VerticalAlignment="Center" Click="OnRemoveRowClick"
                                    i18n:Localized.AutomationName="common.remove" i18n:Localized.ToolTip="common.remove">
                                <Path Width="10" Height="10" Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                      StrokeLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                                   Foreground="{DynamicResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- The list's reset closes it, beside Add (config-sets-conventions, Reset). -->
        <DockPanel>
            <Button x:Name="ResetIgnorePatterns" DockPanel.Dock="Right" Classes="tool" VerticalAlignment="Center"
                    i18n:Localized.Content="settings.resetIgnorePatterns" Click="OnResetIgnorePatternsClick"/>
            <Button x:Name="AddPatternButton" HorizontalAlignment="Left" i18n:Localized.Content="common.add" Click="OnAddPatternClick"/>
        </DockPanel>
    </StackPanel>

        <Grid x:Name="SaveErrorResult" IsVisible="{Binding HasSaveError}"
              AutomationProperties.LiveSetting="Assertive">
            <TextBlock Text="{Binding SaveError}"
                       Foreground="{DynamicResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
        </Grid>

    </StackPanel>
</UserControl>
